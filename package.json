{
  "name": "slack-viewer",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "bin": {
    "slack-viewer": "./dist/index.js"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "web": "concurrently --kill-others-on-fail -n server,vite -c cyan,yellow \"tsx web/server/index.ts\" \"vite web/client --open\"",
    "web:server": "tsx web/server/index.ts",
    "web:client": "vite web/client",
    "build": "tsc",
    "build:web": "vite build web/client",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@inquirer/prompts": "^7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@slack/web-api": "^7",
    "chalk": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "ora": "^8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.0",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "^3"
  }
}
