{
  "name": "slack-viewer",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "bin": {
    "slack-viewer": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests"
  },
  "dependencies": {
    "@inquirer/prompts": "^7",
    "@slack/web-api": "^7",
    "chalk": "^5",
    "ora": "^8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3",
    "eslint": "^10.4.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3"
  }
}
